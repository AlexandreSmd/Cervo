{
  "name": "cervo-daily",
  "private": true,
  "version": "0.1.0",
  "description": "Vif — Garder son esprit affûté, vif et précis.",
  "workspaces": [
    "web"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start:local": "node scripts/setup.mjs && node scripts/dev.mjs",
    "setup": "node scripts/setup.mjs",
    "dev": "node scripts/dev.mjs",
    "db:reset": "node scripts/db-reset.mjs",
    "db:seed:demo": "node scripts/run-api-tool.mjs seed_demo",
    "test": "node scripts/test.mjs",
    "test:e2e": "node scripts/e2e.mjs",
    "questions:check": "node scripts/run-api-tool.mjs check",
    "questions:import": "node scripts/run-api-tool.mjs import_questions",
    "lint": "node scripts/lint.mjs",
    "format": "node scripts/lint.mjs --fix",
    "check": "node scripts/lint.mjs && node scripts/test.mjs",
    "prod:check": "node scripts/prod.mjs check",
    "prod:deploy": "node scripts/prod.mjs deploy",
    "prod:api": "node scripts/prod.mjs api",
    "prod:seed": "node scripts/prod.mjs seed",
    "prod:web": "node scripts/prod.mjs web"
  },
  "devDependencies": {
    "firebase-tools": "^15.0.0",
    "wrangler": "^4.149.0"
  }
}
