# Configuration locale d'Aiguisé (copiée en .env.local par `npm run setup`).
# Ces valeurs fonctionnent telles quelles avec les émulateurs Firebase : aucun compte requis.
APP_ENV=local
FIREBASE_PROJECT_ID=demo-cervo-daily
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
ADMIN_EMAILS=admin@cervo.test
TIMEZONE=Europe/Paris
VITE_USE_FIREBASE_EMULATOR=true
VITE_DEV_TOOLS=true
VITE_FIREBASE_PROJECT_ID=demo-cervo-daily
VITE_FIREBASE_API_KEY=demo-api-key
