# Configuration de production : copie ce fichier en .env.production et remplis-le
# (voir docs/DEPLOIEMENT.md). Ces valeurs ne sont pas secrètes : elles finissent dans le site.

# Domaine du site (sans https://)
PROD_DOMAIN=playvif.com
# Seul compte autorisé dans l'espace fondateur (séparer par des virgules pour en ajouter)
ADMIN_EMAILS=a.simaillaud@gmail.com

# Configuration Web Firebase (console Firebase > Paramètres du projet > Vos applications)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=

# Nom de la base Firestore si tu lui as donné un nom (sinon laisser vide)
FIRESTORE_DATABASE=

# Serveurs de l'API toujours allumés : 1 = rapide, environ 5 $/mois (couverts par les crédits Modal)
# 0 = gratuit, mais 3 à 6 s d'attente à la première visite après une pause. Vide = 1.
API_WARM_CONTAINERS=

# Ne pas modifier
VITE_USE_FIREBASE_EMULATOR=false
VITE_DEV_TOOLS=false
TIMEZONE=Europe/Paris
